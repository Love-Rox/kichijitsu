{
  "expo": {
    "name": "kichijitsu",
    "slug": "kichijitsu",
    "scheme": "kichijitsu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "@react-native-community/datetimepicker",
      "@bacons/apple-targets"
    ],
    "ios": {
      "bundleIdentifier": "cc.love-rox.kichijitsu",
      "appleTeamId": "M296DX39G6",
      "supportsTablet": false,
      "buildNumber": "18",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.cc.love-rox.kichijitsu"
        ]
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FAF7F2"
  }
}
